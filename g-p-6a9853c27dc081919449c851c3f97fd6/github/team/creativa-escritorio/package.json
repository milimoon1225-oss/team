{
  "name": "creativa-impresos-escritorio",
  "productName": "Creativa Impresos",
  "version": "0.1.0",
  "description": "Espacio de trabajo de Creativa Impresos para Windows",
  "author": "Creativa Impresos",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "node scripts/preparar-web.mjs",
    "start": "electron .",
    "test": "node --test test/seguridad.test.mjs",
    "test:app": "node test/aplicacion.mjs",
    "package": "npm run prepare:web && electron-builder --win dir --x64",
    "dist": "npm run prepare:web && electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "pe.creativaimpresos.equipo",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["main.cjs", "seguridad.cjs", "web/**/*", "package.json"],
    "artifactName": "Creativa-Impresos-${version}-${arch}.${ext}",
    "win": { "target": ["nsis", "portable"], "signAndEditExecutable": false },
    "nsis": {
      "artifactName": "Creativa-Impresos-${version}-${arch}-Instalador.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["es_ES"],
      "language": "3082"
    },
    "portable": { "artifactName": "Creativa-Impresos-${version}-${arch}-Portable.${ext}" }
  }
}
